# Example jevtri configuration. jevtri reads /etc/jevtri/jevtri.conf.
# Run 'sudo jevtri init' to write that file from the logs found on this
# server, or copy this file there and edit it. See jevtri(1).
#
# The API key is not written here. Put it alone on one line in
# /etc/jevtri/api-key, owned by root with mode 0600.

# Configuration syntax example (inactive):
# [log example]
# path = /path/to/app.log # Optional comment
# time_format = iso-space
# group = app
# docker_container = container-name # Optional Docker metadata
# docker_project = project-name # Optional Compose metadata

[general]
# Minutes before the reference time to look at when -m is not given.
# minutes = 5
# JSON state size per request includes excerpts, names and incident metadata.
# This bounds JSON escaping as well as the excerpt budget shared among logs.
# max_bytes = 40000
# Where each run is recorded (JSON Lines). Rotated by /etc/logrotate.d/jevtri.
# sent_log = /var/log/jevtri/sent.log

[log messages]
path = /var/log/messages
time_format = syslog
# Groups the log is in; repeat for several. init writes system for host logs.
group = system

[log secure]
path = /var/log/secure
time_format = syslog

[log nginx-error]
path = /var/log/nginx/error.log
time_format = slash-ymd
# Read rotated .gz files too when the window reaches back into them.
# read_compressed = yes

[log tomcat]
# A pattern matches files with a date in their name.
path = /var/log/tomcat/catalina.*.log
time_format = dmy-month
# For logs written without a time zone, when it is not the server's.
# timezone = Asia/Tokyo
# Extra text to mask before sending, as a regular expression. May repeat.
# mask = order-\d+

# Use the actual path verified during registration; update it after recreation.
# [log web]
# path = /srv/docker/containers/CONTAINER_ID/CONTAINER_ID-json.log
# time_format = docker-json
# docker_container = web
# docker_project = shop
# group = shop

# A systemd unit read with journalctl, or * for the whole journal.
# [log docker-daemon]
# journal_unit = docker.service
